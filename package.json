{
  "name": "running-calculator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc && node scripts/pages.ts",
    "test": "node --test 'test/*.test.ts'",
    "test:e2e": "node --test 'test/e2e/*.test.ts'",
    "size": "for f in $(find site -type f); do gzip -9c \"$f\" | wc -c; done | awk '{ s += $1 } END { print s \" B gzipped (budget 10240)\"; exit s > 10240 }'",
    "fmt": "dprint fmt",
    "fmt:check": "dprint check"
  },
  "devDependencies": {
    "dprint": "^0.64.3",
    "playwright": "1.65.0",
    "typescript": "^7.0.2"
  }
}
